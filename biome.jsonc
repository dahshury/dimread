{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  // Scope Biome to the renderer app + repo tooling. src-tauri is Rust
  // (cargo fmt). Generated bindings are never hand-authored.
  "files": {
    "includes": [
      "src/**",
      "tools/**",
      "*.{js,mjs,cjs,ts,mts,cts,jsonc}",
      "package.json",
      "!!**/node_modules",
      "!!**/dist",
      // Vendored skill tooling (the FSD checker) — not repo-authored code;
      // basename globs like *.mjs would otherwise pull it into scope. The
      // checker is duplicated across agent-tool skill dirs (.claude, .agents).
      "!!.claude",
      "!!.agents",
      "!!src/bindings.ts",
      "!!**/*.generated.*",
      "!!src-tauri",
      "!!public",
      "!!**/*.svg"
    ]
  },
  // Tabs, LF, double quotes, semicolons, trailing-all. Overrides Ultracite's
  // 2-space / es5-trailing defaults.
  "formatter": {
    "indentStyle": "tab"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    },
    // Bun is the test runtime (bun:test + Bun.file); it isn't in Biome's
    // default browser/Node global set.
    "globals": ["Bun"]
  },
  // The sorting assists reorder object keys, interface members, JSX attributes
  // and imports across the whole tree — a massive, review-hostile diff (and a
  // behavioral risk for spread/side-effect-import order). Keep them off; the
  // linter still runs.
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off",
        "useSortedAttributes": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedKeys": "off",
        "useSortedProperties": "off",
        "useSortedTypeFields": "off",
        "useSortedPackageJson": "off"
      }
    }
  },
  // Relax the Ultracite rules that clash with this codebase's deliberate,
  // established conventions (carried from the WinSTT source tree the shared
  // primitives were extracted from). Everything not listed here stays at
  // Ultracite's default (mostly error).
  "linter": {
    "rules": {
      "a11y": {
        // The design-system primitives (comboboxes, data-grid, switcher,
        // overlays) implement composed keyboard/focus behavior that Biome's
        // static a11y rules can't see; they fire on fully-accessible custom
        // interactive elements.
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off",
        "noNoninteractiveElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useAriaPropsSupportedByRole": "off",
        "noLabelWithoutControl": "off"
      },
      "correctness": {
        // React Compiler owns memoization; hook-deps enforcement is delegated.
        "useExhaustiveDependencies": "off",
        // A CLS/SEO rule for the web — this is a Tauri desktop app serving
        // local/bundled images.
        "useImageSize": "off"
      },
      "performance": {
        // Inline handlers/props in JSX are idiomatic here — the React Compiler
        // memoizes them.
        "noJsxPropsBind": "off",
        // Feature-Sliced Design exposes each slice through an index.ts barrel.
        "noBarrelFile": "off",
        "noReExportAll": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off",
        "noAwaitInLoops": "off"
      },
      "style": {
        // Components are PascalCase per FSD.
        "useFilenamingConvention": "off",
        // Re-exporting an imported symbol is the FSD barrel pattern.
        "noExportedImports": "off",
        "noIncrementDecrement": "off",
        "noNestedTernary": "off",
        "useConsistentTypeDefinitions": "off",
        "useDefaultSwitchClause": "off",
        "useDestructuring": "off",
        // Hand-tuned CSS cascade is deliberate.
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        // `void promise` marks intentional fire-and-forget (see fireAndForget).
        "noVoid": "off",
        "noExcessiveCognitiveComplexity": "off",
        // Conflicts with tsconfig `noPropertyAccessFromIndexSignature`.
        "useLiteralKeys": "off",
        // Conflicts with tsconfig `noImplicitReturns`.
        "noUselessUndefined": "off"
      },
      "suspicious": {
        // `== null` / `!= null` is the intentional null-or-undefined idiom.
        "noEqualsToNull": "off",
        "noUnnecessaryConditions": "off",
        "noShadow": "off",
        // Async signatures without await are used for interface conformance.
        "useAwait": "off",
        "noBitwiseOperators": "off",
        "noLeakedRender": "off",
        // Positional/static render sets whose identity IS the position.
        "noArrayIndexKey": "off"
      },
      "nursery": {
        // Tailwind class sorting fights the intentional twMerge/cn ordering.
        "useSortedClasses": "off"
      }
    }
  },
  "overrides": [
    {
      // Tests legitimately assert non-null on values they construct and know
      // are present.
      "includes": ["**/*.{test,spec}.{ts,tsx}", "**/*test-helpers*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off",
            "useThrowOnlyError": "off",
            "noParameterProperties": "off"
          },
          "performance": {
            // Tests use `delete globalThis.x` to clean up readonly globals.
            "noDelete": "off"
          },
          "suspicious": {
            "noTemplateCurlyInString": "off",
            "useArraySortCompare": "off"
          }
        }
      }
    },
    {
      // Linting is scoped to the shipped renderer (`src/`). Dev/CLI tooling,
      // root config, and HTML entry points are still FORMATTED by Biome but
      // not linted. Listed last so it wins over the test-file override.
      "includes": [
        "tools/**",
        "windows/**",
        "*.{js,mjs,cjs,ts,mts,cts}",
        "*.html"
      ],
      "linter": { "enabled": false }
    }
  ]
}
