{
  "name": "dimread",
  "private": true,
  "version": "0.0.3-alpha",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "dev:altport": "tauri dev --config tools/tauri-dev-altport.conf.json",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check . && bun tools/i18n/check-no-literal-string.ts",
    "lint:fix": "biome check --write . && bun tools/i18n/check-no-literal-string.ts",
    "format": "biome format --write . && cd src-tauri && cargo fmt",
    "format:check": "biome format . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "biome format --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "typecheck": "bun run typecheck:app && bun run typecheck:node",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.all.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test": "bun test ./src",
    "check:i18n": "bun tools/i18n/check-i18n.ts",
    "check:cycles": "node tools/check-cycles.mjs src",
    "check:deadcode": "knip",
    "check:fsd": "node .claude/skills/feature-sliced-design/check-fsd.mjs",
    "check:lockfile": "bun install --frozen-lockfile --dry-run --ignore-scripts",
    "check:react": "react-doctor --no-supply-chain --blocking error --scope full --yes",
    "check:rust": "cd src-tauri && cargo fmt --all -- --check && cargo clippy --all-targets --locked -- -D warnings && cargo test --locked",
    "check:rust:linux": "node tools/linux/check-linux.mjs",
    "check:rust:linux:quick": "node tools/linux/check-linux.mjs --quick",
    "docs:shots": "node tools/docs/capture-screenshots.mjs",
    "docs:dev": "bun --cwd docs-site run dev",
    "docs:build": "bun --cwd docs-site run build",
    "hooks:install": "node tools/git-hooks/install.mjs",
    "postinstall": "bun run hooks:install",
    "precommit": "bun run check:lockfile && bun run lint && bun run typecheck && bun run check:fsd && bun run check:cycles",
    "prepush": "bun run check:lockfile && bun run test && bun run check:deadcode && bun run check:i18n && bun run check:react && bun run prepush:scoped",
    "prepush:scoped": "node tools/git-hooks/prepush-scoped.mjs",
    "doctor": "bunx react-doctor"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "double-metaphone": "^2.0.1",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "use-intl": "^4.13.0",
    "virtua": "^0.49.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/parser": "^8.0.0",
    "@biomejs/biome": "2.5.2",
    "@happy-dom/global-registrator": "^20.10.6",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "fast-check": "^4.8.0",
    "knip": "^6.23.0",
    "playwright": "^1.62.0",
    "react-doctor": "^0.7.8",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "ultracite": "7.9.2",
    "vite": "^8.0.16"
  },
  "overrides": {
    "@tauri-apps/api": "2.11.1"
  }
}
