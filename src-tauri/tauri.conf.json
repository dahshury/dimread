{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "DimRead",
	"version": "0.0.2-alpha",
	"identifier": "com.dahshury.dimread",
	"mainBinaryName": "dimread",
	"build": {
		"beforeDevCommand": {
			"script": "bun run dev:vite",
			"cwd": ".."
		},
		"devUrl": "http://127.0.0.1:1430",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'; base-uri 'self'",
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": ["$RESOURCE/**"],
					"requireLiteralLeadingDot": false
				}
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "appimage", "deb", "rpm"],
		"license": "MIT",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"hardenedRuntime": true,
			"minimumSystemVersion": "10.15",
			"signingIdentity": "-"
		},
		"linux": {
			"deb": {
				"depends": ["libayatana-appindicator3-1"]
			},
			"rpm": {
				"depends": ["libayatana-appindicator-gtk3"]
			}
		},
		"windows": {
			"nsis": {
				"template": "nsis/installer.nsi"
			}
		}
	}
}
